<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>PulseTrade.Comm.Spa.Dynamic</PackageId>
    <Version>0.1.0-alpha1</Version>
    <Authors>PulseTrade Team</Authors>
    <Description>Dynamic SDUI and Actor extension for PulseTrade.Comm.Spa</Description>
    <WebSharperProject>Bundle</WebSharperProject>
    <WebSharperBundleOutputDir>wwwroot\js</WebSharperBundleOutputDir>
    <WebSharperRunCompiler>true</WebSharperRunCompiler>
    <WebSharperRunCompiler>true</WebSharperRunCompiler>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="poc.dynamic.fsx" />
    <None Include="poc.dynamic.beta8.extension-smoke.fsx" />
    <Compile Include="Library.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FAkka.FCell2" Version="10.1.301" />
    <PackageReference Include="PulseTrade.Comm.Spa" Version="0.2.4-beta8" />
    <PackageReference Include="WebSharper.FSharp" Version="10.1.5.674" />
    <PackageReference Include="WebSharper.FSharp" Version="10.1.5.674" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Server/FCell2Interop.fs" />
    <Compile Include="Server/DynamicActors.fs" />
    <Compile Include="Server/Extension.fs" />
    <Compile Include="Client/DynamicRenderer.fs" />
    <Compile Include="Client/ActorDynamicTab.fs" />
  </ItemGroup>

  <ItemGroup />

</Project>
