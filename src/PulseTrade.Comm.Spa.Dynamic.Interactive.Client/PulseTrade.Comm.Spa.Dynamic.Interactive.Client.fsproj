<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateProgramFile>false</GenerateProgramFile>
    <IsPackable>true</IsPackable>
    <PackageId>PulseTrade.Comm.Spa.Dynamic.Interactive.Client</PackageId>
    <Version>0.1.0-alpha9</Version>
    <Authors>PulseTrade Team</Authors>
    <Description>Transport-neutral WebSharper client shell for embedding the Dynamic SDUI runtime in interactive hosts.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <LangVersion>preview</LangVersion>
    <WebSharperProject>spa</WebSharperProject>
    <WebSharperBundleOutputDir>wwwroot\js</WebSharperBundleOutputDir>
    <WebSharperRunCompiler>true</WebSharperRunCompiler>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Client.fs" />
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="bundle.manifest.json" Pack="true" PackagePath="contentFiles\any\any\ptcs-dynamic-interactive\bundle.manifest.json" PackageCopyToOutput="true" />
    <None Include="wwwroot\js\PulseTrade.Comm.Spa.Dynamic.Interactive.Client.js" Pack="true" PackagePath="contentFiles\any\any\ptcs-dynamic-interactive\client.js" PackageCopyToOutput="true" />
    <None Include="wwwroot\js\PulseTrade.Comm.Spa.Dynamic.Interactive.Client.min.js" Pack="true" PackagePath="contentFiles\any\any\ptcs-dynamic-interactive\client.min.js" PackageCopyToOutput="true" />
    <None Include="wwwroot\js\WebSharper.Core.JavaScript\Runtime.js" Pack="true" PackagePath="contentFiles\any\any\ptcs-dynamic-interactive\WebSharper.Core.JavaScript\Runtime.js" PackageCopyToOutput="true" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" Version="[10.1.400]" />
    <PackageReference Include="PulseTrade.Comm.Spa.Dynamic.Contracts" Version="[0.1.0-alpha16]" />
    <PackageReference Include="PulseTrade.Comm.Spa.Dynamic.Renderer" Version="[0.1.0-alpha38]" />
    <PackageReference Include="WebSharper.FSharp" Version="10.1.6.676" />
    <PackageReference Include="WebSharper.UI" Version="10.1.5.676" />
  </ItemGroup>
</Project>
