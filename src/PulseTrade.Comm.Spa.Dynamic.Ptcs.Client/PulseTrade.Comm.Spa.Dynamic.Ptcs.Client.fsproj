<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateProgramFile>false</GenerateProgramFile>
    <IsPackable>true</IsPackable>
    <PackageId>PulseTrade.Comm.Spa.Dynamic.Ptcs.Client</PackageId>
    <Version>0.1.8</Version>
    <Authors>PulseTrade Team</Authors>
    <Description>Pure WebSharper same-origin PTCS transient client adapter for Dynamic TA Research.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <LangVersion>preview</LangVersion>
    <WebSharperProject>Library</WebSharperProject>
    <WebSharperRunCompiler>true</WebSharperRunCompiler>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PowerShellExe Condition="'$(OS)' == 'Windows_NT'">powershell</PowerShellExe>
    <PulseTradeCommSpaDynamicPtcsClientPushNuGet Condition="'$(PulseTradeCommSpaDynamicPtcsClientPushNuGet)' == '' and '$(BuildingInsideVisualStudio)' == 'true'">true</PulseTradeCommSpaDynamicPtcsClientPushNuGet>
    <PulseTradeCommSpaDynamicPtcsClientPushNuGet Condition="'$(PulseTradeCommSpaDynamicPtcsClientPushNuGet)' == ''">false</PulseTradeCommSpaDynamicPtcsClientPushNuGet>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Client.fs" />
    <Compile Include="ReplyPresentation.fs" />
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" Version="[10.1.400]" />
    <PackageReference Include="PulseTrade.Comm.Spa.Dynamic.Contracts" Version="[0.1.7]" />
    <PackageReference Include="PulseTrade.Comm.Spa.Dynamic.Renderer" Version="[0.1.14]" />
    <PackageReference Include="PulseTrade.Comm.Spa" Version="[0.2.18]" />
    <PackageReference Include="WebSharper.FSharp" Version="10.1.6.676" />
    <PackageReference Include="WebSharper.UI" Version="10.1.5.676" />
  </ItemGroup>

  <Target Name="PushDynamicPtcsClientReleasePackageToNuGet"
          AfterTargets="Pack"
          Condition="'$(Configuration)' == 'Release' and '$(OS)' == 'Windows_NT' and '$(PulseTradeCommSpaDynamicPtcsClientPushNuGet)' == 'true'">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)"
          Command="$(PowerShellExe) -NoProfile -ExecutionPolicy Bypass -File &quot;G:\PulseTrade.fs\Libs\Akka.Proc.Supervisor\PostBuildEvent.ps1&quot; -assembly &quot;$(PackageId)&quot; -build &quot;$(Configuration)&quot;" />
  </Target>
</Project>
