<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>PulseTrade.Comm.Spa.Dynamic</PackageId>
    <Version>0.1.3-beta60</Version>
    <Authors>PulseTrade Team</Authors>
    <Description>Dynamic SDUI and Actor extension for PulseTrade.Comm.Spa</Description>
    <WebSharperProject>Bundle</WebSharperProject>
    <WebSharperBundleOutputDir>wwwroot\js</WebSharperBundleOutputDir>
    <WebSharperRunCompiler>true</WebSharperRunCompiler>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="poc.full.nuget.journal.ACL.fsx" />
    <None Include="poc.full.nuget.journal.ACL2.fsx" />
    <None Include="poc.full.nuget.2.fsx" />
    <None Include="poc.full.nuget.journal.fsx" />
    <None Include="poc.full.nuget.fsx" />
    <None Include="PostBuildEvent.ps1" />
    <Content Include="canvas_demo.json" />
    <None Include="poc.dynamic.fsx" />
    <None Include="poc.dynamic.beta8.extension-smoke.fsx" />
    <Compile Include="Library.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FAkka.Argu" Version="10.1.301" />
    <PackageReference Include="FAkka.FCell2" Version="10.1.301" />
    <PackageReference Include="PulseTrade.Comm.Actor.Registry" Version="[0.1.0-alpha5]" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="WebSharper.FSharp" Version="10.1.5.674" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PulseTrade.Comm.Spa" Version="[0.2.5-beta70]" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Server/ArguForm.fs" />
    <Compile Include="Server/FCell2Interop.fs" />
    <Compile Include="Server/DynamicActors.fs" />
    <Compile Include="Server/Extension.fs" />
    <Compile Include="Client/DynamicRenderer.fs" />
    <Compile Include="Client/ArguFormRenderer.fs" />
    <Compile Include="Client/ActorDynamicTab.fs" />
	  <None Include="G:\PulseTrade.fs\Libs\PulseTrade.Comm\scripts\run-ptcs-host-dynamic-argu-test-host.fsx">
		  <Link>run-ptcs-host-dynamic-argu-test-host.fsx</Link>
	  </None>
	  <None Include="G:\PulseTrade.fs\Libs/PulseTrade.Comm/scripts/run-ptcs-dynamic-nuget-live-host.fsx">
		  <Link>run-ptcs-dynamic-nuget-live-host.fsx</Link>
	  </None>
	  <None Include="G:\PulseTrade.fs\Libs/PulseTrade.Comm/scripts/verify-ptcs-dynamic-nuget-bundle.fsx">
		  <Link>verify-ptcs-dynamic-nuget-bundle.fsx</Link>
	  </None>

  </ItemGroup>

  <ItemGroup>
    <Content Include="wwwroot\**\*.*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

	<PropertyGroup>
		<PowerShellExe Condition="'$(OS)' == 'Windows_NT'">powershell</PowerShellExe>
		<PowerShellExe Condition="'$(OS)' != 'Windows_NT'">pwsh</PowerShellExe>
	</PropertyGroup>
	<Target Name="PostBuildR" AfterTargets="Pack" Condition="'$(Configuration)' == 'Release' and '$(PulseTradeCommSpaDynamicPushNuGet)' == 'true'">
		<Exec Command="$(PowerShellExe) -c &quot;write-host '====== Start Post-Build Event ======'&quot;&#xD;&#xA;$(PowerShellExe) ./PostBuildEvent.ps1 PulseTrade.Comm.Spa.Dynamic Release" />
	</Target>

	<Target Name="PostBuildD" AfterTargets="Pack" Condition="'$(Configuration)' == 'Debug' and '$(PulseTradeCommSpaDynamicPushNuGet)' == 'true'">
		<Exec Command="$(PowerShellExe) -c &quot;write-host '====== Start Post-Build Event ======'&quot;&#xD;&#xA;$(PowerShellExe) ./PostBuildEvent.ps1 PulseTrade.Comm.Spa.Dynamic Debug" />
	</Target>
</Project>


