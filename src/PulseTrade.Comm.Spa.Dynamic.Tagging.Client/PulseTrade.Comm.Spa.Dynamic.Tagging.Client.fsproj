<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateProgramFile>false</GenerateProgramFile>
    <IsPackable>true</IsPackable>
    <PackageId>PulseTrade.Comm.Spa.Dynamic.Tagging.Client</PackageId>
    <Version>0.1.13</Version>
    <Authors>PulseTrade Team</Authors>
    <Description>Transport-neutral PTCS Dynamic SDUI ExtraInfo editor Plug-In for WebSharper clients.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <LangVersion>preview</LangVersion>
    <WebSharperProject>Library</WebSharperProject>
    <WebSharperRunCompiler>true</WebSharperRunCompiler>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PowerShellExe Condition="'$(OS)' == 'Windows_NT'">powershell</PowerShellExe>
    <PulseTradeCommSpaDynamicTaggingClientPushNuGet Condition="'$(PulseTradeCommSpaDynamicTaggingClientPushNuGet)' == '' and '$(BuildingInsideVisualStudio)' == 'true'">true</PulseTradeCommSpaDynamicTaggingClientPushNuGet>
    <PulseTradeCommSpaDynamicTaggingClientPushNuGet Condition="'$(PulseTradeCommSpaDynamicTaggingClientPushNuGet)' == ''">false</PulseTradeCommSpaDynamicTaggingClientPushNuGet>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="TaggingEditorPlugin.fs" />
    <Compile Include="TaggingSearchPlugin.fs" />
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" Version="[10.1.402]" />
    <PackageReference Include="PulseTrade.Comm.Spa.Dynamic.Contracts" Version="[0.1.42]" />
    <PackageReference Include="WebSharper.FSharp" Version="10.1.7.680" />
  </ItemGroup>
  <Target Name="PushDynamicTaggingClientReleasePackageToNuGet"
          AfterTargets="Pack"
          Condition="'$(Configuration)' == 'Release' and '$(OS)' == 'Windows_NT' and '$(PulseTradeCommSpaDynamicTaggingClientPushNuGet)' == 'true' and '$(PublishNuGetAfterPack)' != 'false'">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)"
          Command="$(PowerShellExe) -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\PostBuildEvent.ps1&quot; -PackageId &quot;$(PackageId)&quot; -PackageVersion &quot;$(PackageVersion)&quot; -Configuration &quot;$(Configuration)&quot; -ProjectDirectory &quot;$(MSBuildProjectDirectory)&quot; -PackageFilePath &quot;$(PackageOutputPath)\$(PackageId).$(PackageVersion).nupkg&quot; -PushRelease" />
  </Target>
</Project>
