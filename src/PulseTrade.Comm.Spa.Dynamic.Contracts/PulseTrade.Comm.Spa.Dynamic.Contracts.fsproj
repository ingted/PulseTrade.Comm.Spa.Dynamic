<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateProgramFile>false</GenerateProgramFile>
    <IsPackable>true</IsPackable>
    <PackageId>PulseTrade.Comm.Spa.Dynamic.Contracts</PackageId>
    <Version>0.1.6</Version>
    <Authors>PulseTrade Team</Authors>
    <Description>Transport-neutral SDUI runtime contracts and reducer for PulseTrade.Comm.Spa.Dynamic.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <LangVersion>preview</LangVersion>
    <WebSharperProject>Library</WebSharperProject>
    <WebSharperRunCompiler>true</WebSharperRunCompiler>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
    <PowerShellExe Condition="'$(OS)' == 'Windows_NT'">powershell</PowerShellExe>
    <PulseTradeCommSpaDynamicContractsPushNuGet Condition="'$(PulseTradeCommSpaDynamicContractsPushNuGet)' == '' and '$(BuildingInsideVisualStudio)' == 'true'">true</PulseTradeCommSpaDynamicContractsPushNuGet>
    <PulseTradeCommSpaDynamicContractsPushNuGet Condition="'$(PulseTradeCommSpaDynamicContractsPushNuGet)' == ''">false</PulseTradeCommSpaDynamicContractsPushNuGet>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="RuntimeTypes.fs" />
    <Compile Include="RuntimeValidation.fs" />
    <Compile Include="TemporalSeries.fs" />
    <Compile Include="RuntimeCodec.fs" />
    <Compile Include="SourceEnvelope.fs" />
    <Compile Include="EditorAction.fs" />
    <Compile Include="RuntimeReducer.fs" />
    <Compile Include="RuntimeCache.fs" />
    <Compile Include="BrowserRuntimeCodec.fs" />
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" Version="[10.1.400]" />
    <PackageReference Include="FSharp.SystemTextJson" Version="1.4.36" />
    <PackageReference Include="WebSharper.FSharp" Version="10.1.5.674" />
  </ItemGroup>

  <Target Name="PushContractsReleasePackageToNuGet"
          AfterTargets="Pack"
          Condition="'$(Configuration)' == 'Release' and '$(OS)' == 'Windows_NT' and '$(PulseTradeCommSpaDynamicContractsPushNuGet)' == 'true'">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)"
          Command="$(PowerShellExe) -NoProfile -ExecutionPolicy Bypass -File &quot;G:\PulseTrade.fs\Libs\Akka.Proc.Supervisor\PostBuildEvent.ps1&quot; -assembly &quot;$(PackageId)&quot; -build &quot;$(Configuration)&quot;" />
  </Target>
</Project>
