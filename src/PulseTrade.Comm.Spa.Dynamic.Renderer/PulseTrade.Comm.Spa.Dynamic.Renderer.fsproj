<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateProgramFile>false</GenerateProgramFile>
    <IsPackable>true</IsPackable>
    <PackageId>PulseTrade.Comm.Spa.Dynamic.Renderer</PackageId>
    <Version>0.3.16</Version>
    <Authors>PulseTrade Team</Authors>
    <Description>Pure WebSharper renderer for transport-neutral PulseTrade Dynamic SDUI runtime documents.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <LangVersion>preview</LangVersion>
    <WebSharperProject>Library</WebSharperProject>
    <WebSharperRunCompiler>true</WebSharperRunCompiler>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
    <PowerShellExe Condition="'$(OS)' == 'Windows_NT'">powershell</PowerShellExe>
    <PulseTradeCommSpaDynamicRendererPushNuGet Condition="'$(PulseTradeCommSpaDynamicRendererPushNuGet)' == '' and '$(BuildingInsideVisualStudio)' == 'true'">true</PulseTradeCommSpaDynamicRendererPushNuGet>
    <PulseTradeCommSpaDynamicRendererPushNuGet Condition="'$(PulseTradeCommSpaDynamicRendererPushNuGet)' == ''">false</PulseTradeCommSpaDynamicRendererPushNuGet>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="DisplayTime.fs" />
    <Compile Include="RendererModel.fs" />
    <Compile Include="Renderer.fs" />
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" Version="[10.1.402]" />
    <PackageReference Include="PulseTrade.Comm.Spa.Dynamic.Contracts" Version="[0.1.41]" />
    <PackageReference Include="WebSharper.FSharp" Version="10.1.7.680" />
    <PackageReference Include="WebSharper.UI" Version="10.1.6.680" />
  </ItemGroup>

  <Target Name="PushDynamicRendererReleasePackageToNuGet" AfterTargets="Pack" Condition="'$(Configuration)' == 'Release' and '$(OS)' == 'Windows_NT' and '$(PulseTradeCommSpaDynamicRendererPushNuGet)' == 'true' and '$(PublishNuGetAfterPack)' != 'false'">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)" Command="$(PowerShellExe) -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\PostBuildEvent.ps1&quot; -PackageId &quot;$(PackageId)&quot; -PackageVersion &quot;$(PackageVersion)&quot; -Configuration &quot;$(Configuration)&quot; -ProjectDirectory &quot;$(MSBuildProjectDirectory)&quot; -PackageFilePath &quot;$(PackageOutputPath)\$(PackageId).$(PackageVersion).nupkg&quot; -PushRelease" />
  </Target>
</Project>
