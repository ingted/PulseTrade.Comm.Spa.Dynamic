<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateProgramFile>false</GenerateProgramFile>
    <IsPackable>true</IsPackable>
    <PackageId>PulseTrade.Comm.Spa.Dynamic.Ptcs</PackageId>
    <Version>0.2.6</Version>
    <Authors>PulseTrade Team</Authors>
    <Description>PTCS same-session transient adapter for PulseTrade Dynamic SDUI runtime.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <LangVersion>preview</LangVersion>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
    <PowerShellExe Condition="'$(OS)' == 'Windows_NT'">powershell</PowerShellExe>
    <PulseTradeCommSpaDynamicPtcsPushNuGet Condition="'$(PulseTradeCommSpaDynamicPtcsPushNuGet)' == '' and '$(BuildingInsideVisualStudio)' == 'true'">true</PulseTradeCommSpaDynamicPtcsPushNuGet>
    <PulseTradeCommSpaDynamicPtcsPushNuGet Condition="'$(PulseTradeCommSpaDynamicPtcsPushNuGet)' == ''">false</PulseTradeCommSpaDynamicPtcsPushNuGet>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Server\TaResearchTransient.fs" Link="TaResearchTransient.fs" />
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" Version="[10.1.402]" />
    <PackageReference Include="PulseTrade.Comm.Spa" Version="[0.3.7]" />
    <PackageReference Include="PulseTrade.Comm.Spa.Dynamic.Contracts" Version="[0.1.41]" />
  </ItemGroup>

  <Target Name="SharedPostBuildEventAfterPack"
          AfterTargets="Pack"
          Condition="'$(OS)' == 'Windows_NT' and ('$(Configuration)' == 'Debug' or '$(Configuration)' == 'Release')">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)"
          Condition="'$(Configuration)' != 'Release' or '$(PulseTradeCommSpaDynamicPtcsPushNuGet)' != 'true' or '$(PublishNuGetAfterPack)' == 'false' or '$(SkipNuGetPush)' == 'true'"
          Command="$(PowerShellExe) -NoProfile -ExecutionPolicy Bypass -File &quot;G:\PulseTrade.fs\PostBuildEvent.ps1&quot; -PackageId &quot;$(PackageId)&quot; -PackageVersion &quot;$(PackageVersion)&quot; -Configuration &quot;$(Configuration)&quot; -ProjectDirectory &quot;$(MSBuildProjectDirectory)&quot; -PackageFilePath &quot;$([System.IO.Path]::Combine('$(PackageOutputPath)', '$(PackageId).$(PackageVersion).nupkg'))&quot;" />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)"
          Condition="'$(Configuration)' == 'Release' and '$(PulseTradeCommSpaDynamicPtcsPushNuGet)' == 'true' and '$(PublishNuGetAfterPack)' != 'false' and '$(SkipNuGetPush)' != 'true'"
          Command="$(PowerShellExe) -NoProfile -ExecutionPolicy Bypass -File &quot;G:\PulseTrade.fs\PostBuildEvent.ps1&quot; -PackageId &quot;$(PackageId)&quot; -PackageVersion &quot;$(PackageVersion)&quot; -Configuration &quot;$(Configuration)&quot; -ProjectDirectory &quot;$(MSBuildProjectDirectory)&quot; -PackageFilePath &quot;$([System.IO.Path]::Combine('$(PackageOutputPath)', '$(PackageId).$(PackageVersion).nupkg'))&quot; -PushRelease" />
  </Target>
</Project>
