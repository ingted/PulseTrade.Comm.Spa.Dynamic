<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateProgramFile>false</GenerateProgramFile>
    <IsPackable>true</IsPackable>
    <PackageId>PulseTrade.Comm.Spa.Dynamic.Ptcs</PackageId>
    <Version>0.1.0-alpha4</Version>
    <Authors>PulseTrade Team</Authors>
    <Description>PTCS same-session transient adapter for PulseTrade Dynamic SDUI runtime.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <LangVersion>preview</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Server\TaResearchTransient.fs" Link="TaResearchTransient.fs" />
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PulseTrade.Comm.Spa" Version="[0.2.5-beta82]" />
    <PackageReference Include="PulseTrade.Comm.Spa.Dynamic.Contracts" Version="[0.1.0-alpha4]" />
  </ItemGroup>
</Project>
