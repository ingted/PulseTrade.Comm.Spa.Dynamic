<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>PulseTrade.Comm.Spa.Login</PackageId>
    <Version>0.1.1</Version>
    <Authors>PulseTrade Team</Authors>
    <Description>Open PTCS Login extension facade for PulseTrade.Comm.Spa.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <WebSharperProject>Bundle</WebSharperProject>
    <WebSharperBundleOutputDir>wwwroot\js</WebSharperBundleOutputDir>
    <WebSharperRunCompiler>true</WebSharperRunCompiler>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PowerShellExe Condition="'$(OS)' == 'Windows_NT'">powershell</PowerShellExe>
    <PulseTradeCommSpaLoginPushNuGet Condition="'$(PulseTradeCommSpaLoginPushNuGet)' == '' and '$(BuildingInsideVisualStudio)' == 'true'">true</PulseTradeCommSpaLoginPushNuGet>
    <PulseTradeCommSpaLoginPushNuGet Condition="'$(PulseTradeCommSpaLoginPushNuGet)' == ''">false</PulseTradeCommSpaLoginPushNuGet>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <Compile Include="Library.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WebSharper.FSharp" Version="10.1.5.674" />
    <PackageReference Include="PulseTrade.Comm.Spa" Version="[0.2.18]" />
    <PackageReference Include="PulseTrade.Comm.Login.Core" Version="[0.1.1]" />
    <PackageReference Include="PulseTrade.Comm.ACL.Core" Version="[0.1.1]" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="wwwroot\**\*.*" CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="contentFiles\any\net10.0\wwwroot\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <Target Name="PushSpaLoginReleasePackageToNuGet"
          AfterTargets="Pack"
          Condition="'$(Configuration)' == 'Release' and '$(OS)' == 'Windows_NT' and '$(PulseTradeCommSpaLoginPushNuGet)' == 'true'">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)"
          Command="$(PowerShellExe) -NoProfile -ExecutionPolicy Bypass -File &quot;G:\PulseTrade.fs\Libs\Akka.Proc.Supervisor\PostBuildEvent.ps1&quot; -assembly &quot;$(PackageId)&quot; -build &quot;$(Configuration)&quot;" />
  </Target>

</Project>
